generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  password       String?
  accounts       Account[]
  sessions       Session[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Client {
  id        String    @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  dni       String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  vehicles  Vehicle[]

  @@map("clients")
}

model Vehicle {
  id        String         @id @default(cuid())
  plate     String         @unique
  brand     String
  model     String
  year      Int
  color     String?
 VIN       String?
  clientId  String
  client    Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  services  ServiceEntry[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("vehicles")
}

model ServiceEntry {
  id          String   @id @default(cuid())
  description String
  status      ServiceStatus @default(PENDIENTE)
  entryDate   DateTime @default(now())
  exitDate    DateTime?
  laborCost   Decimal  @default(0) @db.Decimal(10, 2)
  partsCost   Decimal  @default(0) @db.Decimal(10, 2)
  totalCost   Decimal  @default(0) @db.Decimal(10, 2)
  notes       String?
  parts       Json?
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("service_entries")
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  entityId  String?
  entityType String?
  createdAt DateTime @default(now())

  @@map("notifications")
}

enum ServiceStatus {
  PENDIENTE
  EN_REPARACION
  LISTO
  ENTREGADO
}
